{
  "name": "choicescript-tree",
  "version": "1.0.0",
  "type": "module",
  "main": "api.ts",
  "scripts": {
    "dev": "vite",
    "build:web": "vite build",
    "generate:token-types": "tsx scanner/generate-token-types.ts",
    "fetch": "tsx fetch/index.ts",
    "scan": "tsx scanner/cli.ts",
    "parse": "tsx parser/index.ts",
    "run": "tsx run.ts",
    "start": "npm run scan && npm run parse && npm run analyse",
    "analyse": "tsx analysis/ref-cfg/run.ts",
    "test": "tsx tests/run.ts",
    "test:update": "tsx tests/run.ts --update",
    "static-output": "tsx renderer/static-output/index.ts",
    "build:ext": "cd extension && node esbuild.mjs",
    "watch:ext": "cd extension && node esbuild.mjs --watch"
  },
  "author": "",
  "license": "MIT",
  "description": "",
  "devDependencies": {
    "@types/node": "^22.7.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^8.0.14"
  },
  "dependencies": {
    "@hpcc-js/wasm-graphviz": "^1.21.5"
  }
}
